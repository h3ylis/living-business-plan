PORT=8800
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/exec
NODE_ENV=development

# Dev mode: bypass Authelia headers and use this identity
DEV_USER_EMAIL=you@example.com
DEV_USER_NAME=Dev

# Base URL for deep links in emails
BASE_URL=http://localhost:8800

# Comma-separated list of all partner emails (for notifications)
PARTNER_EMAILS=partner1@example.com,partner2@example.com,partner3@example.com

# SMTP for notifications (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=exec@yourdomain.com

# MCP Server (optional — for AI-powered plan access)
# EXEC_MCP_TRANSPORT=streamable-http
# EXEC_MCP_PORT=8801
